# Environment Variables for zkWasm Protocol Deployment

# ================================
# PRIVATE KEYS (NEVER COMMIT REAL KEYS!)
# ================================

# Sepolia Testnet Private Key (for testing)
SEPOLIA_PRIVATE_KEY=your_sepolia_private_key_here

# BSC Mainnet Private Key (for production deployment)
# ⚠️  WARNING: This account will deploy contracts and needs sufficient BNB for gas fees
# ⚠️  Make sure this account has the required permissions and funds
BSC_PRIVATE_KEY=your_bsc_mainnet_private_key_here

# ================================
# RPC ENDPOINTS (Optional - defaults provided)
# ================================

# Sepolia RPC URL (optional - default: https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# BSC Mainnet RPC URL (optional - default: https://bsc-dataseed1.binance.org/)
BSC_RPC_URL=https://bsc-dataseed1.binance.org/

# BSC Testnet RPC URL (optional - default: https://data-seed-prebsc-1-s1.binance.org:8545/)
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# ================================
# API KEYS (Optional)
# ================================

# Infura API Key (if using Infura endpoints)
INFURA_API_KEY=your_infura_api_key_here

# ================================
# DEPLOYMENT ACCOUNT INFO
# ================================

# The account address that corresponds to your private key (for reference)
# This should match the address derived from BSC_PRIVATE_KEY
ACCOUNT=your_account_address_here

# ================================
# SETUP INSTRUCTIONS
# ================================

# 1. Copy this file to .env (DO NOT commit .env to git!)
#    cp env.example .env

# 2. Fill in your actual private key for BSC_PRIVATE_KEY
#    You can get your private key from MetaMask or other wallet

# 3. Ensure your account has enough BNB for deployment:
#    - Contract deployment typically costs 0.01-0.1 BNB
#    - Keep some extra for configuration transactions

# 4. For BSC mainnet deployment, run:
#    npx hardhat run scripts/deploy_bsc_complete.ts --network bsc

# ================================
# SECURITY NOTES
# ================================

# - NEVER commit your real private keys to version control
# - Use a dedicated deployment account, not your main wallet
# - Test on BSC testnet first before mainnet deployment
# - Keep your private keys secure and backed up
# - Consider using hardware wallets for production deployments